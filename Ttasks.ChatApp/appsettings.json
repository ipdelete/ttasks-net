{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChatApp": {
    "MaxContinuationBatches": 2,
    "AllowedTools": [
      { "prefix": "mail",            "description": "Microsoft 365 mail CLI.",                    "helpCommand": "mail --help",            "traits": ["means.communication.email", "operates.on.person", "operates.on.message"] },
      { "prefix": "teams read",      "description": "Read a Teams chat.",                          "helpCommand": "teams read --help",      "traits": ["means.communication.chat", "operates.on.person", "operates.on.message"] },
      { "prefix": "teams read-channel", "description": "Read a Teams channel.",                    "helpCommand": "teams read-channel --help", "traits": ["means.communication.chat", "operates.on.channel", "operates.on.message"] },
      { "prefix": "teams chat-list", "description": "Discover Teams chats by topic substring or member.", "helpCommand": "teams chat-list --help", "traits": ["means.communication.chat", "operates.on.person", "operates.on.chat"] },
      { "prefix": "teams chat-get",  "description": "Read Teams chat metadata by chatId.",         "helpCommand": "teams chat-get --help",  "traits": ["means.communication.chat", "operates.on.chat"] },
      { "prefix": "teams team-list", "description": "List Teams workspaces you belong to.",        "helpCommand": "teams team-list --help", "traits": ["means.communication.chat", "operates.on.team"] },
      { "prefix": "teams team-get",  "description": "Get a Teams workspace by id.",                "helpCommand": "teams team-get --help",  "traits": ["means.communication.chat", "operates.on.team"] },
      { "prefix": "teams channel-list", "description": "List channels in a team.",                 "helpCommand": "teams channel-list --help", "traits": ["means.communication.chat", "operates.on.team", "operates.on.channel"] },
      { "prefix": "teams channel-get",  "description": "Get a Teams channel by team/channel id.",  "helpCommand": "teams channel-get --help",  "traits": ["means.communication.chat", "operates.on.channel"] },
      { "prefix": "calendar list",   "description": "List calendar events.",                       "helpCommand": "calendar --help",        "traits": ["means.scheduling.calendar", "operates.on.person", "operates.on.appointment"] },
      { "prefix": "az account list", "description": "List Azure subscriptions.",                                                              "traits": ["means.infrastructure.azure", "operates.on.subscription"] },
      { "prefix": "az group list",   "description": "List Azure resource groups.",                                                            "traits": ["means.infrastructure.azure", "operates.on.resourcegroup"] },
      { "prefix": "az resource list","description": "List Azure resources.",                                                                  "traits": ["means.infrastructure.azure", "operates.on.resource"] },
      { "prefix": "git log",    "description": "Show commit history (text output).",         "helpCommand": "git log --help",    "traits": ["means.versioncontrol.git", "operates.on.commit"] },
      { "prefix": "git status", "description": "Show working tree status (text output).",    "helpCommand": "git status --help", "traits": ["means.versioncontrol.git", "operates.on.workingtree"] },
      { "prefix": "git diff",   "description": "Show changes (text output).",                "helpCommand": "git diff --help",   "traits": ["means.versioncontrol.git", "operates.on.workingtree", "operates.on.commit"] },
      { "prefix": "git show",   "description": "Show a commit by hash (text output).",       "helpCommand": "git show --help",   "traits": ["means.versioncontrol.git", "operates.on.commit"] }
    ],
    "LibrarySeed": [
      {
        "key": "calendar.today",
        "displayName": "Read today's calendar",
        "description": "List calendar events for today and return them as JSON.",
        "fileName": "calendar",
        "argsTemplate": [
          "list",
          "-s",
          "{today:yyyy-MM-dd}T00:00:00",
          "-e",
          "{tomorrow:yyyy-MM-dd}T00:00:00",
          "-n",
          "{top}",
          "--json"
        ],
        "parameters": [
          { "name": "today",    "source": "clock.now" },
          { "name": "tomorrow", "source": "clock.tomorrow" },
          { "name": "top",      "source": "default", "defaultValue": 10 }
        ]
      },
      {
        "key": "az.account.list",
        "displayName": "List Azure subscriptions",
        "description": "List accessible Azure subscriptions as JSON.",
        "fileName": "az",
        "argsTemplate": [ "account", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      },
      {
        "key": "az.group.list",
        "displayName": "List Azure resource groups",
        "description": "List Azure resource groups in the active subscription as JSON.",
        "fileName": "az",
        "argsTemplate": [ "group", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      },
      {
        "key": "az.resource.list",
        "displayName": "List Azure resources",
        "description": "List Azure resources in the active subscription as JSON.",
        "fileName": "az",
        "argsTemplate": [ "resource", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      }
    ]
  }
}
