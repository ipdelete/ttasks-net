{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChatApp": {
    "MaxContinuationBatches": 2,
    "AllowedTools": [
      { "prefix": "gh issue list",    "description": "List GitHub issues in a repo.",                  "helpCommand": "gh issue list --help",    "traits": ["means.versioncontrol.github", "operates.on.issue"] },
      { "prefix": "gh issue view",    "description": "View a GitHub issue by number.",                 "helpCommand": "gh issue view --help",    "traits": ["means.versioncontrol.github", "operates.on.issue"] },
      { "prefix": "gh pr list",       "description": "List GitHub pull requests in a repo.",           "helpCommand": "gh pr list --help",       "traits": ["means.versioncontrol.github", "operates.on.pullrequest"] },
      { "prefix": "gh pr view",       "description": "View a GitHub pull request by number.",          "helpCommand": "gh pr view --help",       "traits": ["means.versioncontrol.github", "operates.on.pullrequest"] },
      { "prefix": "gh run list",      "description": "List GitHub Actions workflow runs.",             "helpCommand": "gh run list --help",      "traits": ["means.versioncontrol.github", "operates.on.workflow"] },
      { "prefix": "gh run view",      "description": "View a GitHub Actions workflow run by id.",      "helpCommand": "gh run view --help",      "traits": ["means.versioncontrol.github", "operates.on.workflow"] },
      { "prefix": "gh repo view",     "description": "View GitHub repository metadata.",               "helpCommand": "gh repo view --help",     "traits": ["means.versioncontrol.github", "operates.on.repo"] },
      { "prefix": "git log",          "description": "Show commit history (text output).",             "helpCommand": "git log --help",          "traits": ["means.versioncontrol.git", "operates.on.commit"] },
      { "prefix": "git status",       "description": "Show working tree status (text output).",        "helpCommand": "git status --help",       "traits": ["means.versioncontrol.git", "operates.on.workingtree"] },
      { "prefix": "git diff",         "description": "Show changes (text output).",                    "helpCommand": "git diff --help",         "traits": ["means.versioncontrol.git", "operates.on.workingtree", "operates.on.commit"] },
      { "prefix": "git show",         "description": "Show a commit by hash (text output).",           "helpCommand": "git show --help",         "traits": ["means.versioncontrol.git", "operates.on.commit"] },
      { "prefix": "docker ps",        "description": "List running Docker containers.",                "helpCommand": "docker ps --help",        "traits": ["means.infrastructure.docker", "operates.on.container"] },
      { "prefix": "docker images",    "description": "List local Docker images.",                      "helpCommand": "docker images --help",    "traits": ["means.infrastructure.docker", "operates.on.image"] },
      { "prefix": "docker logs",      "description": "Fetch logs from a Docker container.",            "helpCommand": "docker logs --help",      "traits": ["means.infrastructure.docker", "operates.on.container"] },
      { "prefix": "az account list",  "description": "List Azure subscriptions.",                                                                "traits": ["means.infrastructure.azure", "operates.on.subscription"] },
      { "prefix": "az group list",    "description": "List Azure resource groups.",                                                              "traits": ["means.infrastructure.azure", "operates.on.resourcegroup"] },
      { "prefix": "az resource list", "description": "List Azure resources.",                                                                    "traits": ["means.infrastructure.azure", "operates.on.resource"] }
    ],
    "LibrarySeed": [
      {
        "key": "gh.issue.list",
        "displayName": "List GitHub issues",
        "description": "List open issues in a GitHub repo as JSON.",
        "fileName": "gh",
        "argsTemplate": [ "issue", "list", "--repo", "{repo}", "--state", "open", "--limit", "{limit}", "--json", "number,title,state,createdAt,author,labels" ],
        "parameters": [
          { "name": "repo",  "source": "user" },
          { "name": "limit", "source": "default", "defaultValue": 20 }
        ]
      },
      {
        "key": "gh.pr.list",
        "displayName": "List GitHub pull requests",
        "description": "List open pull requests in a GitHub repo as JSON.",
        "fileName": "gh",
        "argsTemplate": [ "pr", "list", "--repo", "{repo}", "--state", "open", "--limit", "{limit}", "--json", "number,title,state,createdAt,author,headRefName" ],
        "parameters": [
          { "name": "repo",  "source": "user" },
          { "name": "limit", "source": "default", "defaultValue": 20 }
        ]
      },
      {
        "key": "gh.run.list",
        "displayName": "List GitHub Actions runs",
        "description": "List recent workflow runs in a GitHub repo as JSON.",
        "fileName": "gh",
        "argsTemplate": [ "run", "list", "--repo", "{repo}", "--limit", "{limit}", "--json", "databaseId,displayTitle,status,conclusion,startedAt,workflowName" ],
        "parameters": [
          { "name": "repo",  "source": "user" },
          { "name": "limit", "source": "default", "defaultValue": 10 }
        ]
      },
      {
        "key": "az.account.list",
        "displayName": "List Azure subscriptions",
        "description": "List accessible Azure subscriptions as JSON.",
        "fileName": "az",
        "argsTemplate": [ "account", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      },
      {
        "key": "az.group.list",
        "displayName": "List Azure resource groups",
        "description": "List Azure resource groups in the active subscription as JSON.",
        "fileName": "az",
        "argsTemplate": [ "group", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      }
    ]
  }
}
