{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChatApp": {
    "AllowedTools": [
      { "prefix": "mail",            "description": "Microsoft 365 mail CLI.",                    "helpCommand": "mail --help" },
      { "prefix": "teams read",      "description": "Read a Teams chat.",                          "helpCommand": "teams read --help" },
      { "prefix": "teams read-channel", "description": "Read a Teams channel.",                    "helpCommand": "teams read-channel --help" },
      { "prefix": "teams chat-list", "description": "Discover Teams chats by topic substring or member.", "helpCommand": "teams chat-list --help" },
      { "prefix": "teams chat-get",  "description": "Read Teams chat metadata by chatId.",         "helpCommand": "teams chat-get --help" },
      { "prefix": "teams team-list", "description": "List Teams workspaces you belong to.",        "helpCommand": "teams team-list --help" },
      { "prefix": "teams team-get",  "description": "Get a Teams workspace by id.",                "helpCommand": "teams team-get --help" },
      { "prefix": "teams channel-list", "description": "List channels in a team.",                 "helpCommand": "teams channel-list --help" },
      { "prefix": "teams channel-get",  "description": "Get a Teams channel by team/channel id.",  "helpCommand": "teams channel-get --help" },
      { "prefix": "calendar list",   "description": "List calendar events.",                       "helpCommand": "calendar --help" },
      { "prefix": "az account list", "description": "List Azure subscriptions." },
      { "prefix": "az group list",   "description": "List Azure resource groups." },
      { "prefix": "az resource list","description": "List Azure resources." }
    ],
    "LibrarySeed": [
      {
        "key": "calendar.today",
        "displayName": "Read today's calendar",
        "description": "List calendar events for today and return them as JSON.",
        "fileName": "calendar",
        "argsTemplate": [
          "list",
          "-s",
          "{today:yyyy-MM-dd}T00:00:00",
          "-e",
          "{tomorrow:yyyy-MM-dd}T00:00:00",
          "-n",
          "{top}",
          "--json"
        ],
        "parameters": [
          { "name": "today",    "source": "clock.now" },
          { "name": "tomorrow", "source": "clock.tomorrow" },
          { "name": "top",      "source": "default", "defaultValue": 10 }
        ]
      },
      {
        "key": "az.account.list",
        "displayName": "List Azure subscriptions",
        "description": "List accessible Azure subscriptions as JSON.",
        "fileName": "az",
        "argsTemplate": [ "account", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      },
      {
        "key": "az.group.list",
        "displayName": "List Azure resource groups",
        "description": "List Azure resource groups in the active subscription as JSON.",
        "fileName": "az",
        "argsTemplate": [ "group", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      },
      {
        "key": "az.resource.list",
        "displayName": "List Azure resources",
        "description": "List Azure resources in the active subscription as JSON.",
        "fileName": "az",
        "argsTemplate": [ "resource", "list", "--only-show-errors", "--output", "json" ],
        "parameters": []
      }
    ]
  }
}
